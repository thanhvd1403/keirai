# Keirai systemd service - keeps the bot alive and starts it on boot.
# Installs from and runs in your home directory (~/keirai).
#
# Install:
#   1. Put the project in ~/keirai (git clone) and create config.json there.
#   2. Copy this file:  sudo cp deploy/keirai.service /etc/systemd/system/
#   3. Edit User=/Group= below to your server username. %h expands to that
#      user's home directory automatically.
#   4. sudo systemctl daemon-reload
#   5. sudo systemctl enable --now keirai
#
# Useful commands:
#   systemctl status keirai          # is it running?
#   journalctl -u keirai -f          # live logs
#   sudo systemctl restart keirai    # after code/config changes
#   sudo systemctl disable keirai    # remove autostart

[Unit]
Description=Keirai Telegram AI Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# run as a normal user, not root - change to your username
User=youruser
WorkingDirectory=%h/keirai
ExecStart=/usr/bin/python3 %h/keirai/main.py
# keep alive: restart on crash, on exit, on kill
Restart=always
RestartSec=3
# hard memory cap - protects the potato (cap, not reservation; idle usage ~20MB)
MemoryMax=256M
# stop Python from buffering stdout (live logs in journalctl)
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
